@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="py-20 md:py-32">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight">
            Oops! Something went wrong
        </h1>
        
        <p class="mt-6 max-w-2xl mx-auto text-lg text-slate-400">
            We're sorry, but something unexpected happened. Please try again later.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-4 text-sm text-slate-500">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="mt-8">
            <a href="/" class="text-white font-semibold py-3 px-6 rounded-lg btn-gradient transition-all duration-300 inline-block">
                Go Back Home
            </a>
        </div>
    </div>
</section>