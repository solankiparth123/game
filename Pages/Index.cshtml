@page
@model IndexModel
@{
    ViewData["Title"] = "World's Biggest Concert";
}

<section class="py-20 md:py-32">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <!-- Main Headline -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight">
            LET'S JOIN CONCERT OF THE
            <br>
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-indigo-400">BIGGEST BAND</span>
            IN THE WORLD
        </h1>
        
        <!-- Subheading -->
        <p class="mt-6 max-w-2xl mx-auto text-lg text-slate-400">
            The latest concert ticket ordering platform that is easy to reach, fast, and at low prices. 
            Find your favorite band, order tickets now.
        </p>
        
        <!-- Band Image -->
        <div class="mt-12">
            <img src="https://placehold.co/1000x500/0c0a09/e2e8f0?text=Band+Image" 
                 alt="Image of a music band performing on stage" 
                 class="rounded-xl mx-auto shadow-2xl shadow-purple-500/10" 
                 onerror="this.onerror=null;this.src='https://placehold.co/1000x500/0c0a09/e2e8f0?text=Image+Not+Found';">
        </div>
    </div>
</section>

<!-- Sponsors Section -->
<partial name="_SponsorsSection" />